# insights-service — database (ADR-0010: three databases on ONE Postgres instance)
#
# DB_HOST and DB_PORT are the SAME for all three services. What differs is
# DB_NAME and the role: one Postgres server holds many databases, and the
# connection string picks one. PostgreSQL cannot query across databases, so
# this is the isolation boundary, not a convention.

DB_HOST=localhost
DB_PORT=5500
DB_NAME=fireplace_insights

# The role the RUNNING SERVICE connects as. DML only — no CREATE. If this role
# can create a table, the grants are wrong (ADR-0010 §2).
DB_USER=fireplace_insights_app
DB_PASSWORD=app

# The role MIGRATIONS connect as, used only by ./cmd/migrate and the migrate-*
# make targets. Holds DDL. The service must never use these.
DB_OWNER_USER=fireplace_insights_owner
DB_OWNER_PASSWORD=owner

# Point at the test instance (port 6500, databases suffixed _test) to run
# migrations against the mirrored test tier.

# Static service discovery (ADR-0012 §4) — Consul is gone. Under `air` these
# are localhost; in compose they are container names.
PLAN_SERVICE_ADDR=localhost:7103

# Structured generators (FS-DF4ZB R8): model, output-token ceiling and
# reasoning effort per generator. The ceiling includes reasoning tokens; a
# truncated answer is a failed generation. The day plan (FS-02JBZ R6): unset
# means gpt-5-mini, 1600 tokens, minimal reasoning.
# DAY_PLAN_MODEL=gpt-5-mini
# DAY_PLAN_MAX_OUTPUT_TOKENS=1600
# DAY_PLAN_REASONING_EFFORT=minimal

# Global daily token budget (ADR-0019, FS-02JBZ R34): input + output tokens
# summed from the usage ledger per server UTC day, across every model call.
# At or over it, generators refuse with LLM_BUDGET_EXHAUSTED (429). Unset means
# 200000; production defaults to 2000000 in docker-compose.prod.yml.
LLM_DAILY_TOKEN_BUDGET=200000
