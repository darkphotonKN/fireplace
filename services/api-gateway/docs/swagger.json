{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "HTTP edge for the Fireplace microservices. This spec is a\ncode-generated SHAPE contract (OpenAPI 2.0), not a validator:\nruntime validation lives in Go (gin `binding` tags at the edge,\ndomain invariants in the downstream services). Conditional\nrules are described in prose on each field, never encoded as\nschema constraints. See docs/api-conventions.md.",
        "title": "Fireplace API Gateway",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/plans/{id}/checklists": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Lists non-archived checklist items for a plan, optionally\nfiltered by scope and/or type.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "checklists"
                ],
                "summary": "List checklist items",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Plan ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "enum": [
                            "daily",
                            "longterm"
                        ],
                        "type": "string",
                        "description": "Filter by scope",
                        "name": "scope",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "task",
                            "note"
                        ],
                        "type": "string",
                        "description": "Filter by type",
                        "name": "type",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ChecklistListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Creates a checklist item (task or note) under the given plan.\n`scope` and `type` are optional shape enums. Parent nesting is\nvalidated downstream by plan-service (a parent must be a\ntop-level item in the same plan — two-tier maximum); that rule\nis enforced in code, not in this schema.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "checklists"
                ],
                "summary": "Create a checklist item",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Plan ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Checklist item to create",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.CreateChecklistReq"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ChecklistResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    }
                }
            }
        },
