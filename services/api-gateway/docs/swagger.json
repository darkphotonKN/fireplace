                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/plans/{id}/checklists/{checklist_id}/archive": {
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Archives the item (sets archived=true). The request body is\nignored — this endpoint always archives, mirroring the monolith.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "checklists"
                ],
                "summary": "Archive a checklist item",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Plan ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Checklist item ID (UUID)",
                        "name": "checklist_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ChecklistResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
