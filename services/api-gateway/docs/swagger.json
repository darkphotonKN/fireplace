                "produces": [
                    "application/json"
                ],
                "tags": [
                    "checklists"
                ],
                "summary": "Delete a checklist item",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Plan ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Checklist item ID (UUID)",
                        "name": "checklist_id",
                        "in": "path",
                        "required": true
