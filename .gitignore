# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib

# Go build artifacts (match per-service paths anywhere in the tree)
bin/
build/
dist/
*.out
*.prof
*.coverprofile
__debug_bin*

# Temporary files
*.log
*.tmp
*.temp

# OS generated files
.DS_Store
Thumbs.db

# IDE-specific files
.vscode/
.idea/
*.swp

# Environment variables and credentials
.env

# Dependencies
vendor/

# Go module files (if not using vendoring)
go.sum

# Docker
.dockerignore

# Test results
*.test
coverage.out

# Claude / MCP scaffolding — never push these at any depth
CLAUDE.md
CLAUDE_PROJECT_TEMPLATE.md
PROMPT_TEMPLATE.md
GO_MCP_CODE_TEMPLATES.md
GO_MCP_PROJECT_TEMPLATE.md
GO_MCP_TEMPLATE_SUMMARY.md
setup-go-mcp-project.sh
.claude/

# Air hot-reload tmp dirs — match the directory and everything inside,
# at any depth (e.g. services/auth-service/tmp/main).
tmp/
tmp/*
