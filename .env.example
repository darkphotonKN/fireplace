# Root compose environment. Copy to .env for local development; supply the same
# variables from OUTSIDE the repository in production (ADR-0012 §5).
#
#   local       docker compose up -d
#   production  docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# The base file gives every DB password a dev-safe default, so locally you only
# strictly need JWT_SECRET. docker-compose.prod.yml re-declares ALL of them as
# required, so a missing secret fails at `compose up` rather than booting
# production on a password that is printed in this repository.

# --- Required everywhere -----------------------------------------------------
# Signs and verifies access/refresh tokens. The gateway ISSUES with it and
# insights-service VERIFIES with it, so the two must match exactly.
JWT_SECRET=change-me-to-a-long-random-string

# --- Required in production --------------------------------------------------
OPENAI_API_KEY=

# Public hostname Caddy obtains a certificate for. Must already resolve to this
# box, or the ACME challenge fails.
FIREPLACE_DOMAIN=fireplace.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# --- Database credentials ----------------------------------------------------
# One owner (DDL, migrations only) and one app (DML, no CREATE) role per
# database — ADR-0010 §2. These values are read BOTH by the init script that
# creates the roles AND by the containers that use them, so changing one here
# changes both. Changing them after first boot requires `docker compose down -v`,
# because the init script only runs on an empty volume.
POSTGRES_SUPER_PASSWORD=postgres
GATEWAY_OWNER_PASSWORD=owner
GATEWAY_APP_PASSWORD=app
PLANS_OWNER_PASSWORD=owner
PLANS_APP_PASSWORD=app
INSIGHTS_OWNER_PASSWORD=owner
INSIGHTS_APP_PASSWORD=app

RABBITMQ_PASSWORD=fireplace
