                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    }
                }
            },
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Partial update. All fields optional; `parentId` is three-state\n(omit = leave, null = clear, value = set). Domain rules\n(task→note conversion blocked when the item has children;\nre-parenting constrained to two tiers within the same plan) are\nenforced downstream, not in this schema.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "checklists"
                ],
                "summary": "Update a checklist item",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Plan ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Checklist item ID (UUID)",
                        "name": "checklist_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to update",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.UpdateChecklistReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ChecklistResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
