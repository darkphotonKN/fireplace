                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/plans/{id}/checklists/{checklist_id}/dates": {
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Sets, clears, or leaves the item's start/due dates. Both fields\nare OPTIONAL and three-state (omit = leave, null = clear,\n\"YYYY-MM-DD\" = set).\n\nCONDITIONAL RULE (enforced downstream in plan-service, described\nhere in prose and intentionally NOT encoded in the schema): when\nboth dates are present, `startDate` must be on or before\n`dueDate`. The spec is a shape contract, not a validator — see\ndocs/api-conventions.md.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "checklists"
                ],
                "summary": "Update checklist item dates",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Plan ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Checklist item ID (UUID)",
                        "name": "checklist_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Dates to set/clear",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.UpdateDatesReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ChecklistResponse"
                        }
                    },
                    "400": {
                        "description": "e.g. startDate after dueDate (enforced downstream)",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_gateway_plan.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
